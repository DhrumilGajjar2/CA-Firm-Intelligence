NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info

# Matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ca_firm_intelligence?schema=public

# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h

FRONTEND_URL=http://localhost:3000

# Swagger UI at /docs (defaults to on outside production)
# ENABLE_DOCS=true

# Later phases
REDIS_URL=redis://localhost:6379
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# Dedicated PostgreSQL database for the Vitest suite. The database name MUST contain "test" (the test
# helpers refuse to truncate anything else). Create it once, e.g.: CREATE DATABASE "CA_INTELLIGENCE_PORTAL_TEST";
# Migrations are applied to it automatically by the test run. If unset, DB-backed tests are skipped.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/CA_INTELLIGENCE_PORTAL_TEST?schema=public
